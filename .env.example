# Copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=3000
HOST=0.0.0.0

# --- Database: must be a LOCAL disk (SQLite WAL). In Docker this is the /data volume. ---
DATABASE_PATH=./data/lemiesz.db

# --- Deployment (docker compose) ---
# ORIGIN is REQUIRED in both modes: the exact URL users type, e.g. https://lemiesz.example.org
# or http://100.64.0.5:3000 over Tailscale. Without it adapter-node assumes https and
# SvelteKit rejects every form POST (CSRF origin check).
ORIGIN=
# Mode B (local / Tailscale): bind address for the published port. Default is 127.0.0.1.
APP_BIND=127.0.0.1
# Mode A (VPS behind Caddy): also set DOMAIN, and ADDRESS_HEADER so rate limiting sees real client IPs.
DOMAIN=
ADDRESS_HEADER=
XFF_DEPTH=1

# --- Authentication ---
# The first admin is created from these when the users table is empty. Min 12 characters.
# Remove ADMIN_PASSWORD from the environment after the first start.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Local development only (ignored when NODE_ENV=production): skip login.
# AUTH_DISABLED=true

# --- Backups (see docs/OPERATIONS.md) ---
# Hours between automatic backups (0 = off) and how many to keep. BACKUP_DIR should be ANOTHER disk.
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14
# BACKUP_DIR=

# --- AI spend and review ---
# Per user per day: chat + content generation + card generation.
# LLM_DAILY_REQUESTS=300
# Share of AI-verified cards sent to a human for spot-checking, and the disagreement rate that raises an alarm.
# REVIEW_SAMPLE_PERCENT=10
# REVIEW_DISAGREEMENT_ALERT=0.2

# --- Content Engine ---
# Require a reviewer other than the author before a draft counts as reviewed.
# CONTENT_REQUIRE_SECOND_REVIEWER=true

# --- Seed corpus ---
# Set to false to start with an empty database instead of the starter sources.
# SEED_ON_EMPTY=true

# --- LLM (paid, non-training API tier only; see docs/implementation_plan.md §1) ---
# Any OpenAI-compatible endpoint works (OpenAI, Gemini's OpenAI-compatible API, DeepSeek, ...).
# The drafter and the auditor must use different model families.
LLM_DRAFTER_BASE_URL=
LLM_DRAFTER_API_KEY=
LLM_DRAFTER_MODEL=
LLM_AUDITOR_BASE_URL=
LLM_AUDITOR_API_KEY=
LLM_AUDITOR_MODEL=
LLM_CHAT_BASE_URL=
LLM_CHAT_API_KEY=
LLM_CHAT_MODEL=

# --- Embeddings ---
# local = multilingual-e5-small on this machine (no API cost); openai = an OpenAI-compatible embeddings API
EMBEDDER=local
# Where the local model is cached after its first download (in Docker: on the /data volume).
# MODEL_CACHE_DIR=./data/models
# Retrieval thresholds, calibrated by pnpm eval (see docs/implementation_plan.md).
# RAG_VECTOR_MIN=0.79
EMBEDDER_BASE_URL=
EMBEDDER_API_KEY=
EMBEDDER_MODEL=
