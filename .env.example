# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# SQLite Database Location (Must be a local disk / NVMe mount for WAL locking)
DATABASE_PATH=/data/lemiesz.db

# Authentication (Passphrase for core team access)
AUTH_SECRET=change_me_to_a_secure_passphrase

# LLM Providers Configuration (Paid, contractual zero-training tiers)
LLM_PROVIDER=gemini # options: gemini, deepseek, openai
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Embeddings Configuration
EMBEDDER=local # options: local, openai
# OPENAI_API_KEY used if EMBEDDER=openai
