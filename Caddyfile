# Caddyfile for Pakt Lemiesza — VPS mode (docker compose --profile vps up -d)
# Caddy sets X-Forwarded-For / X-Forwarded-Proto itself; the app reads them via ADDRESS_HEADER / ORIGIN.
{$DOMAIN:lemiesz.local} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	reverse_proxy app:3000
}
