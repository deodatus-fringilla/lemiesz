{
	"name": "lemiesz",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "pnpm paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"start": "node build/index.js",
		"test:watch": "vitest",
		"smoke": "node scripts/smoke.mjs",
		"eval": "vitest run --config vitest.eval.config.ts",
		"robots": "node scripts/robots/run.mjs",
		"robots:sabotage": "node scripts/robots/sabotage.mjs",
		"paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie baseLocale --silent"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.2"
	},
	"dependencies": {
		"@huggingface/transformers": "^4.3.0",
		"@inlang/paraglide-js": "^2.25.4",
		"better-sqlite3": "^13.0.3",
		"clsx": "^2.1.1",
		"lucide-svelte": "^1.0.1",
		"tailwind-merge": "^3.7.0"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.12.1"
}
